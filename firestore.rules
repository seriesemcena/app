rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// Séries em Cena — Firestore security rules
//
// This file is the versioned source of truth. It can be deployed with the
// Firebase CLI configuration in firebase.json or pasted in the console.
//
// Design notes:
// • Aggregate counters and mirrored follow relations are maintained only by
//   trusted Cloud Functions; browser clients cannot forge derived data.
// • reviews/{titleKey} legacy docs (the old `items` array model)
//   are frozen read-only; new reviews live in the items/
//   subcollection where authorUid can be enforced per doc.
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function accountIsActive(uid) {
      return !exists(/databases/$(database)/documents/users/$(uid))
        || (
          exists(/databases/$(database)/documents/users/$(uid)/system/account)
            ? get(/databases/$(database)/documents/users/$(uid)/system/account)
                .data.get('accountStatus', 'active') == 'active'
            : (
              !get(/databases/$(database)/documents/users/$(uid))
                .data.keys().hasAny(['accountStatus'])
              || get(/databases/$(database)/documents/users/$(uid))
                .data.accountStatus == 'active'
            )
        );
    }

    function activeUser() {
      return request.auth != null && accountIsActive(request.auth.uid);
    }

    function togglesOwnReviewLike() {
      let before = resource.data.get('likedBy', []);
      let after = request.resource.data.get('likedBy', []);
      let changed = request.resource.data.diff(resource.data).affectedKeys();

      return changed.hasOnly(['likedBy', 'likes'])
        && request.resource.data.likes is int
        && request.resource.data.likes == after.size()
        && (
          (
            !before.hasAny([request.auth.uid])
            && after.hasAny([request.auth.uid])
            && after.hasAll(before)
            && after.size() == before.size() + 1
          )
          ||
          (
            before.hasAny([request.auth.uid])
            && !after.hasAny([request.auth.uid])
            && before.hasAll(after)
            && after.size() == before.size() - 1
          )
        );
    }

    function appendsOwnReviewReply() {
      let before = resource.data.get('replies', []);
      let after = request.resource.data.get('replies', []);
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let reply = after[after.size() - 1];

      return changed.hasOnly(['replies'])
        && after.size() == before.size() + 1
        && after.hasAll(before)
        && reply is map
        && reply.get('uid', '') == request.auth.uid
        && reply.get('id', '') is string
        && reply.get('id', '').size() > 0
        && reply.get('user', '') is string
        && reply.get('avatar', '') is string
        && reply.get('text', '') is string
        && reply.get('text', '').size() > 0
        && reply.get('text', '').size() <= 5000
        && reply.get('date', '') is string
        && reply.get('photoUrl', '') is string
        && reply.get('gifUrl', '') is string
        && reply.get('imageUrl', '') is string
        && reply.get('spoiler', false) is bool
        && reply.get('likes', 0) == 0
        && reply.get('likedBy', []).size() == 0
        && reply.keys().hasAll([
          'id', 'uid', 'user', 'avatar', 'text', 'date'
        ])
        && reply.keys().hasOnly([
          'id', 'uid', 'user', 'avatar', 'photoUrl', 'text', 'gifUrl',
          'imageUrl', 'spoiler', 'date', 'likes', 'likedBy'
        ]);
    }

    function isProMember(data) {
      return data.get('profile', {}).get('proMember', false) == true;
    }

    function isMaratonouAdmin() {
      return request.auth != null
        && request.auth.token.get('admin', false) == true
        && request.auth.token.get('role', '') in [
          'super_admin', 'admin', 'moderator', 'editor', 'support'
        ];
    }

    function canManageCommunityContent() {
      return isMaratonouAdmin()
        && request.auth.token.get('role', '') in ['super_admin', 'admin', 'editor'];
    }

    function canModerateCommunity() {
      return isMaratonouAdmin()
        && request.auth.token.get('role', '') in [
          'super_admin', 'admin', 'moderator', 'support'
        ];
    }

    // ── Users ────────────────────────────────────────────────
    // Profiles are public inside the app (search, /user/<slug>,
    // follower lookups) → any signed-in account may read.
    // Only the owner writes.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && !request.resource.data.keys().hasAny([
                      'adminAccess', 'accountStatus', 'accountStatusReason',
                      'accountStatusUpdatedAt', 'accountStatusUpdatedBy',
                      'counters', 'prefs', 'expenses', 'blocked_list',
                      'ep_watched', 'fcm_tokens', 'lastActiveAt'
                    ])
                    && !isProMember(request.resource.data);
      allow update: if activeUser()
                    && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny([
                           'adminAccess', 'accountStatus', 'accountStatusReason',
                           'accountStatusUpdatedAt', 'accountStatusUpdatedBy',
                           'counters', 'prefs', 'expenses', 'blocked_list',
                           'ep_watched', 'fcm_tokens', 'lastActiveAt'
                         ])
                    && isProMember(request.resource.data) == isProMember(resource.data);
      allow delete: if false;

      // Owner-only account data. Only known document shapes are accepted so a
      // client cannot turn this subcollection into an unbounded private store.
      match /private/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if activeUser()
                              && request.auth.uid == uid
                              && (
                                (
                                  docId == 'preferences'
                                  && request.resource.data.value is map
                                  && request.resource.data.schemaVersion == 1
                                  && request.resource.data.updatedAt is timestamp
                                  && request.resource.data.keys().hasOnly([
                                    'value', 'schemaVersion', 'updatedAt'
                                  ])
                                )
                                || (
                                  docId == 'expenses'
                                  && request.resource.data.value is list
                                  && request.resource.data.schemaVersion == 1
                                  && request.resource.data.updatedAt is timestamp
                                  && request.resource.data.keys().hasOnly([
                                    'value', 'schemaVersion', 'updatedAt'
                                  ])
                                )
                                || (
                                  docId == 'blocks'
                                  && request.resource.data.value is list
                                  && request.resource.data.value.size() <= 1000
                                  && request.resource.data.schemaVersion == 1
                                  && request.resource.data.updatedAt is timestamp
                                  && request.resource.data.keys().hasOnly([
                                    'value', 'schemaVersion', 'updatedAt'
                                  ])
                                )
                                || (
                                  docId == 'history'
                                  && request.resource.data.value is map
                                  && request.resource.data.schemaVersion == 1
                                  && request.resource.data.updatedAt is timestamp
                                  && request.resource.data.keys().hasOnly([
                                    'value', 'schemaVersion', 'updatedAt'
                                  ])
                                )
                                || (
                                  docId == 'activity'
                                  && request.resource.data.lastActiveAt is timestamp
                                  && request.resource.data.schemaVersion == 1
                                  && request.resource.data.keys().hasOnly([
                                    'lastActiveAt', 'schemaVersion'
                                  ])
                                )
                                || (
                                  docId == 'push'
                                  && request.resource.data.tokens is list
                                  && request.resource.data.tokens.size() <= 20
                                  && request.resource.data.keys().hasOnly(['tokens'])
                                )
                                || (
                                  docId == 'pro_settings'
                                  && request.resource.data.value is map
                                  && request.resource.data.keys().hasOnly(['value'])
                                )
                                || (
                                  docId == 'search_history'
                                  && request.resource.data.items is list
                                  && request.resource.data.items.size() <= 20
                                  && request.resource.data.updatedAt is timestamp
                                  && request.resource.data.keys().hasOnly([
                                    'items', 'updatedAt'
                                  ])
                                )
                                || (
                                  docId == 'migration_state'
                                  && request.resource.data.schemaVersion == 1
                                  && request.resource.data.keys().hasOnly([
                                    'seasonProgressV1', 'privateDataV1',
                                    'seasonProgressMigratedAt',
                                    'privateDataMigratedAt', 'schemaVersion',
                                    'backupRef'
                                  ])
                                )
                              );
        allow delete: if activeUser() && request.auth.uid == uid;
      }

      // Moderation/account state is server-owned and is intentionally outside
      // the public profile and the owner's client-readable private documents.
      match /system/{docId} {
        allow read, write: if false;
      }

      // Explicit reminders created from a future-season card. Cloud Functions
      // reads due documents through the Admin SDK and is the only sender.
      match /seasonReminders/{reminderId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if activeUser()
                              && request.auth.uid == uid
                              && request.resource.data.uid == uid
                              && request.resource.data.keys().hasOnly([
                                'uid', 'tvId', 'seasonNumber', 'title',
                                'premiereDate', 'notifyAt', 'posterPath',
                                'enabled', 'createdAt', 'notifiedAt'
                              ]);
        allow delete: if activeUser() && request.auth.uid == uid;
      }

      // Authoritative progress is one deterministic document per
      // series/season: {seriesId}_s{seasonNumber}. LocalStorage is only a
      // cache; signed-in clients read and write their own canonical records.
      match /seasonProgress/{progressId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if activeUser()
                              && request.auth.uid == uid
                              && request.resource.data.uid == uid
                              && request.resource.data.seriesId is int
                              && request.resource.data.seriesId > 0
                              && request.resource.data.seasonNumber is int
                              && request.resource.data.seasonNumber > 0
                              && progressId == string(request.resource.data.seriesId)
                                + '_s' + string(request.resource.data.seasonNumber)
                              && request.resource.data.watchedEpisodeNumbers is list
                              && request.resource.data.episodeDurations is map
                              && request.resource.data.episodeCount is int
                              && request.resource.data.episodeCount >= 0
                              && request.resource.data.watchedDurationMinutes is int
                              && request.resource.data.watchedDurationMinutes >= 0
                              && request.resource.data.updatedAt is string
                              && request.resource.data.schemaVersion == 1
                              && request.resource.data.source in [
                                'episode', 'season-finish', 'series-finish',
                                'migration', 'reconciliation'
                              ]
                              && request.resource.data.keys().hasOnly([
                                'uid', 'seriesId', 'seasonNumber',
                                'watchedEpisodeNumbers', 'episodeDurations',
                                'episodeCount', 'watchedDurationMinutes',
                                'completedAt', 'updatedAt', 'source',
                                'schemaVersion'
                              ]);
        allow delete: if activeUser() && request.auth.uid == uid;
      }

      // Frequency state is written only by the trusted banner callable so a
      // client cannot reset its own cap or inspect campaign delivery history.
      match /popupBannerState/{bannerId} {
        allow read, write: if false;
      }

      // Canonical social graph. The owner controls only who they follow.
      // Cloud Functions mirror this edge under the target's followers path.
      match /following/{targetUid} {
        allow read: if request.auth != null;
        allow create: if activeUser()
                      && request.auth.uid == uid
                      && targetUid != uid
                      && request.resource.data.userId == targetUid
                      && request.resource.data.keys().hasOnly([
                        'userId', 'username', 'name', 'avatarImage',
                        'avatarLetter', 'avatarGradient', 'createdAt'
                      ]);
        allow update: if activeUser()
                      && request.auth.uid == uid
                      && request.resource.data.userId == targetUid
                      && resource.data.userId == targetUid;
        allow delete: if activeUser() && request.auth.uid == uid;
      }

      match /followers/{followerUid} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // ── Reviews ──────────────────────────────────────────────
    match /reviews/{titleKey} {
      // Legacy array documents are frozen. Any exceptional migration or
      // moderation is executed by the authorized backend, never a client.
      allow read:   if true;
      allow create, update, delete: if false;

      // One doc per review; authorUid pins it to its creator.
      match /items/{reviewId} {
        allow read:   if true;
        allow create: if activeUser()
                      && request.resource.data.authorUid == request.auth.uid;
        allow delete: if activeUser()
                      && resource.data.authorUid == request.auth.uid;
        // A like update may only add/remove the authenticated user's uid.
        // Authors can edit their own content, but likes remain protected.
        // Signed-in members may append exactly one reply owned by themselves.
        allow update: if activeUser()
                      && request.resource.data.authorUid == resource.data.authorUid
                      && (
                           togglesOwnReviewLike()
                           || (
                             resource.data.authorUid == request.auth.uid
                             && !request.resource.data.diff(resource.data)
                                  .affectedKeys()
                                  .hasAny(['likedBy', 'likes', 'replies'])
                           )
                           || appendsOwnReviewReply()
                         );
      }
    }

    // One active rating per user/title. Public screens read only the compact
    // summary; the per-user docs stay available for authenticated detail UIs.
    match /ratings/{titleKey} {
      allow read, write: if false;

      match /userRatings/{uid} {
        allow read: if request.auth != null;
        allow create: if activeUser()
                      && request.auth.uid == uid
                      && request.resource.data.authorUid == uid
                      && request.resource.data.rating is int
                      && request.resource.data.rating >= 1
                      && request.resource.data.rating <= 10;
        allow update: if activeUser()
                      && request.auth.uid == uid
                      && resource.data.authorUid == uid
                      && request.resource.data.authorUid == uid
                      && request.resource.data.rating is int
                      && request.resource.data.rating >= 1
                      && request.resource.data.rating <= 10;
        allow delete: if activeUser() && request.auth.uid == uid;
      }
    }

    match /ratingSummaries/{titleKey} {
      allow read: if true;
      allow write: if false;
    }

    match /userStats/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ── Activity feed ────────────────────────────────────────
    // Posts carry the author's uid; only that author may create
    // them under their name, and only they may delete.
    match /activity/{id} {
      allow read:   if request.auth != null;
      allow create: if activeUser()
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if activeUser()
                    && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ── Notifications ────────────────────────────────────────
    // Creation is server-owned through createSocialNotification so clients
    // cannot forge actor identity or bypass private recipient preferences.
    match /notifications/{id} {
      allow read:   if request.auth != null
                    && resource.data.recipientId == request.auth.uid;
      allow create: if false;
      allow update: if activeUser()
                    && resource.data.recipientId == request.auth.uid
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['read']);
      allow delete: if activeUser()
                    && resource.data.recipientId == request.auth.uid;
    }

    // Automated content notifications are produced by Cloud Functions.
    // The recipient may read, mark as read or dismiss/delete its own inbox.
    match /app_notifications/{id} {
      allow read: if request.auth != null
                  && resource.data.recipientId == request.auth.uid;
      allow create: if false;
      allow delete: if activeUser()
                    && resource.data.recipientId == request.auth.uid;
      allow update: if activeUser()
                    && resource.data.recipientId == request.auth.uid
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['read']);
    }

    // ── Feed reactions ───────────────────────────────────────
    // reactions/{feedItemId} → { users: { uid: emoji } }.
    // Each account may only add/change/remove ITS OWN map entry.
    match /reactions/{feedItemId} {
      allow read:   if true;
      allow create: if activeUser()
                    && request.resource.data.keys().hasOnly(['users'])
                    && request.resource.data.users.keys()
                         .hasOnly([request.auth.uid]);
      allow update: if activeUser()
                    && request.resource.data.keys().hasOnly(['users'])
                    && request.resource.data.users.diff(resource.data.users)
                         .affectedKeys().hasOnly([request.auth.uid]);
      allow delete: if false;
    }

    // ── App config (home slider etc.) ────────────────────────
    // Read-only content; edited via console/Admin SDK only.
    match /config/{docId} {
      allow read:  if true;
      allow write: if false;
    }

    // Manual/scheduled jobs created in the admin panel and consumed by the
    // trusted notification worker. Regular accounts never see this queue.
    match /notification_jobs/{id} {
      allow create, read, update, delete: if false;
    }

    // ── Reports (moderation inbox) ───────────────────────────
    // Any signed-in user files reports (comment/profile/problem);
    // only the admin reads and manages them (/admin → Moderação).
    match /reports/{id} {
      allow create: if activeUser()
                    && request.resource.data.reportedBy == request.auth.uid
                    && request.resource.data.status == 'open'
                    && request.resource.data.contentType in [
                      'comment', 'reply', 'profile', 'movie', 'series', 'other'
                    ]
                    && request.resource.data.contentId is string
                    && request.resource.data.contentId.size() > 0
                    && request.resource.data.contentId.size() <= 500
                    && request.resource.data.get('parentContentId', '') is string
                    && request.resource.data.get('reportedUserId', '') is string
                    && request.resource.data.get('titleId', '') is string
                    && request.resource.data.get('titleType', '') in ['', 'movie', 'tv']
                    && request.resource.data.keys().hasOnly([
                      'kind', 'reason', 'details', 'targetId', 'titleKey',
                      'targetLabel', 'contentSnippet', 'reportedUser',
                      'contentType', 'contentId', 'parentContentId',
                      'reportedUserId', 'titleId', 'titleType', 'reportedBy',
                      'reportedByName', 'status', 'createdAt'
                    ]);
      allow read, update, delete: if false;
    }

    // Administrative data is accessible only through the central API. The
    // Admin SDK bypasses these rules, so the Functions API repeats RBAC.
    match /adminUsers/{uid} {
      allow read, write: if false;
    }

    match /auditLogs/{id} {
      allow read, write: if false;
    }

    match /adminRateLimits/{id} {
      allow read, write: if false;
    }

    match /adminIdempotency/{id} {
      allow read, write: if false;
    }

    match /content_overrides/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Only the sanitized, published projection is readable by the app.
    // Drafts and administrative metadata remain server-only in app_banners.
    match /public_banners/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /app_banners/{id} {
      allow read, write: if false;
    }

    // Pop-up campaigns are selected by a callable backend that enforces
    // schedule, audience and frequency before returning a minimal projection.
    match /public_popup_banners/{id} {
      allow read, write: if false;
    }

    match /popup_banners/{id} {
      allow read, write: if false;
    }

    match /popup_banner_metrics/{id} {
      allow read, write: if false;
    }

    match /popup_banner_event_receipts/{id} {
      allow read, write: if false;
    }

    // Landing pages follow the same publish projection as banners: drafts and
    // author metadata stay private while published HTML is publicly readable.
    match /public_pages/{slug} {
      allow read: if true;
      allow write: if false;
    }

    match /app_pages/{id} {
      allow read, write: if false;
    }

    // ── Maratonou Community ─────────────────────────────────
    // Published help content and discussions are publicly readable. The same
    // Firebase account used by the app is required to participate, while the
    // existing admin custom claims control authoring and moderation.
    match /community_articles/{articleId} {
      allow read: if resource.data.status == 'published'
                  || canManageCommunityContent();
      allow create: if canManageCommunityContent()
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.status in ['draft', 'published']
                    && request.resource.data.keys().hasOnly([
                      'title', 'slug', 'summary', 'category', 'body', 'status',
                      'featured', 'authorUid', 'createdAt', 'updatedAt',
                      'publishedAt'
                    ]);
      allow update: if canManageCommunityContent()
                    && request.resource.data.authorUid
                         == resource.data.get('authorUid', request.auth.uid)
                    && request.resource.data.status in ['draft', 'published']
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly([
                           'title', 'slug', 'summary', 'category', 'body',
                           'status', 'featured', 'authorUid', 'updatedAt',
                           'publishedAt'
                         ]);
      allow delete: if canManageCommunityContent();
    }

    match /community_topics/{topicId} {
      allow read: if true;
      allow create: if activeUser()
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.status == 'open'
                    && request.resource.data.category in [
                      'Dúvida', 'Ideia', 'Problema', 'Elogio'
                    ]
                    && request.resource.data.keys().hasOnly([
                      'title', 'body', 'category', 'status', 'authorUid',
                      'authorName', 'createdAt', 'updatedAt'
                    ]);
      allow update: if (
                      canModerateCommunity()
                      && request.resource.data.authorUid == resource.data.authorUid
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'updatedAt'])
                      && request.resource.data.status in [
                        'open', 'planned', 'resolved', 'closed'
                      ]
                    ) || (
                      activeUser()
                      && resource.data.authorUid == request.auth.uid
                      && request.resource.data.authorUid == resource.data.authorUid
                      && request.resource.data.status == resource.data.status
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['title', 'body', 'category', 'updatedAt'])
                    );
      allow delete: if canModerateCommunity()
                    || (activeUser() && resource.data.authorUid == request.auth.uid);

      match /replies/{replyId} {
        allow read: if true;
        allow create: if activeUser()
                      && request.resource.data.authorUid == request.auth.uid
                      && request.resource.data.authorIsAdmin == isMaratonouAdmin()
                      && request.resource.data.keys().hasOnly([
                        'body', 'authorUid', 'authorName', 'authorIsAdmin',
                        'createdAt', 'updatedAt'
                      ]);
        allow update: if (
                        activeUser()
                        && resource.data.authorUid == request.auth.uid
                        && request.resource.data.authorUid == resource.data.authorUid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['body', 'updatedAt'])
                      ) || canModerateCommunity();
        allow delete: if canModerateCommunity()
                      || (activeUser() && resource.data.authorUid == request.auth.uid);
      }
    }

    match /admin_audit_logs/{id} {
      allow read, write: if false;
    }

    match /notification_state/{id} {
      allow read, write: if false;
    }

    // Materialized views and operational receipts are server-owned.
    match /rankingMonthly/{month} {
      allow read, write: if false;
      match /entries/{uid} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    match /metrics/{id} {
      allow read, write: if false;
    }

    match /metricsDaily/{id} {
      allow read, write: if false;
    }

    match /metricsMonthly/{id} {
      allow read, write: if false;
    }

    match /systemEvents/{id} {
      allow read, write: if false;
    }
  }
}
